# Copy to .env and fill in. Never commit .env.

# ── Core ──────────────────────────────────────────────
DATABASE_URL=mysql://user:password@host:3306/dbname
JWT_SECRET=change-me-to-a-long-random-string
NODE_ENV=development
PORT=3000

# ── Meta (Facebook) app ───────────────────────────────
META_APP_ID=
META_APP_SECRET=
VITE_META_APP_ID=
# Public origin used for the OAuth redirect_uri (no trailing slash)
PUBLIC_APP_URL=http://localhost:3000
# Optional overrides
# META_GRAPH_API_VERSION=v25.0
# META_OAUTH_SCOPES=ads_read,business_management
# META_USE_APPSECRET_PROOF=false

# ── WhatsApp Cloud API webhook (required in production) ─
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ── Manus platform (only if self-hosting outside Manus) ─
VITE_APP_ID=
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://manus.im
OWNER_OPEN_ID=
OWNER_NAME=

# ── Scheduler ─────────────────────────────────────────
# CRON_SCHEDULE=0 0 * * *
